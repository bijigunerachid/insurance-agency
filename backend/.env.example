# Copy to .env (development) and .env.test (tests). Never commit the copies.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Runtime connection: the limited role app_runtime (created by `npm run db:roles`).
# Choose a strong password; it is set on the role from this URL.
DATABASE_URL=postgresql://app_runtime:change-me-runtime@127.0.0.1:55433/agency_dev
# Migrations and role setup: the database owner (same user and password as the root .env).
MIGRATION_DATABASE_URL=postgresql://agency:change-me@127.0.0.1:55433/agency_dev

# Address users type in the browser (used for Origin checks)
APP_ORIGIN=http://127.0.0.1:5173
# Number of reverse proxies in front of the API (0 in development, 1 behind Caddy)
TRUST_PROXY=0
LOG_LEVEL=info
APP_TIMEZONE=Africa/Casablanca

# 32 random bytes, base64. Encrypts two-factor secrets in the database. Keep a copy with the
# backup recovery material: without it, every user must enrol two-factor again.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

# Session lifetimes (defaults shown)
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=10
# Login attempts per client address per 15 minutes (keep 20 in production)
LOGIN_MAX_PER_IP=20

# The agency using this installation (one installation per agency): shown on the screens and
# printed on receipts. Leave empty until known; receipts then show a warning.
AGENCY_NAME=
# Under the name, e.g. Agent général
AGENCY_TAGLINE=
AGENCY_ADDRESS=
AGENCY_PHONE=
AGENCY_FAX=
AGENCY_EMAIL=
# 15 digits
AGENCY_ICE=
# Agrément (ACAPS), e.g. AGT0000.00.CD.0000.000 du jj/mm/aaaa
AGENCY_ACAPS_NUMBER=
# The legal line at the foot of the receipt, as on the letterhead
# e.g. S.A.R.L au capital de 100 000,00 DH
AGENCY_LEGAL_FORM=
AGENCY_PATENTE=
AGENCY_IF=
AGENCY_RC=
AGENCY_CNSS=
# Logo (wide) and tab icon (square): PNG or JPEG, 1 MB at most, kept outside the code,
# e.g. D:\agence\logo.png. Checked at startup.
AGENCY_LOGO_FILE=
AGENCY_ICON_FILE=
# The insurers' cards after sign-in (colour, title, tagline, logo, photo per insurer code): a JSON
# file outside the code, its images in the same folder (README « A new agency », step 4).
# e.g. D:\agence\insurers\insurers.json. Empty: the cards show each insurer's name. Checked at startup.
INSURER_BRANDING_FILE=

# Folder of the scans attached to contracts (PDF, JPEG, PNG; 10 MB each). Outside the web root and
# included in the backups. Relative to the backend folder in development; absolute in production,
# e.g. D:\agence\documents. The server checks at startup that it can write there.
DOCUMENTS_DIR=storage/documents
