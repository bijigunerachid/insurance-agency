{
  "name": "@agency/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node src/server.js",
    "start:test": "node --env-file=.env.test src/server.js",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:roles": "node --env-file-if-exists=.env scripts/db-roles.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:create": "prisma migrate dev --create-only",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "catalogue:confirm-reference": "node --env-file-if-exists=.env scripts/confirm-reference.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tesseract.js-data/fra": "1.0.0",
    "argon2": "0.45.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prisma": "7.10.1",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "supertest": "7.3.1",
    "vitest": "5.0.3"
  }
}
