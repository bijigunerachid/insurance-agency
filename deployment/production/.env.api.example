# API settings in production. Copy to .env.api (never committed) and fill in.
# NODE_ENV, HOST, PORT, TRUST_PROXY and DOCUMENTS_DIR are set by compose.yml.

# Runtime connection: the limited role app_runtime (created by the tools service). A long random
# password, different from the owner's:  openssl rand -hex 24
DATABASE_URL=postgresql://app_runtime:RUNTIME_PASSWORD@db:5432/agency

# The one address of the application, typed in the browsers (https, no path, no trailing /).
APP_ORIGIN=https://agence.internal
LOG_LEVEL=info
APP_TIMEZONE=Africa/Casablanca

# 32 random bytes, base64: encrypts the two-step secrets. Keep a copy with the backup recovery
# material (without it every user enrols two-step again).  openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=10
LOGIN_MAX_PER_IP=20

# The agency using this installation (one installation per agency): shown on the screens and
# printed on receipts. Leave empty until known; receipts then show a warning.
AGENCY_NAME=
# Under the name, e.g. Agent général
AGENCY_TAGLINE=
AGENCY_ADDRESS=
AGENCY_PHONE=
AGENCY_FAX=
AGENCY_EMAIL=
# 15 digits
AGENCY_ICE=
# Agrément (ACAPS), e.g. AGT0000.00.CD.0000.000 du jj/mm/aaaa
AGENCY_ACAPS_NUMBER=
# The legal line at the foot of the receipt, as on the letterhead
# e.g. S.A.R.L au capital de 100 000,00 DH
AGENCY_LEGAL_FORM=
AGENCY_PATENTE=
AGENCY_IF=
AGENCY_RC=
AGENCY_CNSS=
# Logo (wide) and tab icon (square): PNG or JPEG, 1 MB at most, kept outside the code,
# In production: put the files in the "agency" folder next to compose.yml, then
# AGENCY_LOGO_FILE=/data/agency/logo.png and AGENCY_ICON_FILE=/data/agency/icon.png. Checked at startup.
AGENCY_LOGO_FILE=
AGENCY_ICON_FILE=
