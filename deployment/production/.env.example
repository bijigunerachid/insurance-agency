# Server settings for compose.yml. Copy to .env (never committed) and fill in.
# The release installed (set by install.sh).
APP_VERSION=
# The agency's address, the same as APP_ORIGIN in .env.api without https://
APP_HOST=insurance.internal
# The server's fixed address on the office network (the app is published there only).
LAN_IP=192.168.50.10
HTTPS_PORT=443
HTTP_PORT=80
# Empty in production; ":8443" only for a rehearsal on another port.
PUBLIC_HTTPS_SUFFIX=
# Database owner (migrations only). A long random password:
#   openssl rand -hex 24
POSTGRES_USER=agency_owner
POSTGRES_PASSWORD=
POSTGRES_DB=agency
# Where the backup disk is mounted (docs/backup-restore.md).
BACKUP_DISK=/mnt/agency-backup
